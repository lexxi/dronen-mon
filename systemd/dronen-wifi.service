[Unit]
Description=Drohnen-Monitor WLAN Sensor
After=network.target NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=simple
EnvironmentFile=-/etc/default/dronen-mon
ExecStart=/usr/bin/python3 -u /opt/dronen-mon/bin/wifi_monitor.py
Restart=always
RestartSec=5
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
